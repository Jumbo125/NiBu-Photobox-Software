{
    "output": {
        "format": "jpg",
        "jpeg_quality": 88,
        "jpeg_subsampling": "2",
        "jpeg_optimize": false,
        "jpeg_progressive": true,
        "dpi": 300
    },
    "greenwall": {
        "switch": "auto",
        "mode": "auto",
        "diff_threshold": 25,
        "green_min": 150,
        "green_ratio": 1.35,
        "blur_radius": 2,
        "feather": 2,
        "spill_suppression": 0.35,
        "close_iter": 1,
        "write_mask_debug": false
    },
    "render": {
        "resize_mode": "contain",
        "contain_bg": "#8c1212",
        "photo_work_scale": 1.5
    }
}
